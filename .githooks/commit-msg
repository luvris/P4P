#!/bin/sh
#
# commit-msg — กัน footer ของเครื่องมือเขียนโค้ด (Codebuff) ไม่ให้ติดไปกับ commit
#
# เหตุผล: ประวัติของ repo นี้เคยมีบรรทัดโฆษณา/ผู้ร่วมเขียนของ Codebuff ปนอยู่หลาย commit
# ซึ่งไม่เกี่ยวกับเนื้อหางานและทำให้ log อ่านยากขึ้น ฮุกนี้จึงปฏิเสธข้อความ commit
# ที่ยังมี "บรรทัด footer" ดังกล่าว
#
# จับแบบ "ทั้งบรรทัด" (anchored) ไม่ใช่ค้นคำในประโยค จึงยังเขียนข้อความ commit
# ที่พูดถึงเรื่องนี้ได้ เช่น "...the tool's own signature line..."
#
# เปิดใช้ (รันครั้งเดียวต่อ 1 clone):
#   git config core.hooksPath "$(git rev-parse --show-toplevel)/.githooks"
#
# ต้องเป็น absolute path — ถ้าใส่เป็น ".githooks" เฉย ๆ ฮุกจะหาไม่เจอเมื่อ
# commit จากโฟลเดอร์ย่อย (เช่น backend/) แล้ว git จะข้ามฮุกไปเงียบ ๆ
#
# ข้ามการตรวจเมื่อจำเป็นจริง ๆ:
#   git commit --no-verify
#
# หมายเหตุ: git ส่ง path ของไฟล์ข้อความ commit มาเป็นอาร์กิวเมนต์ตัวแรก
#           บรรทัดที่ขึ้นต้นด้วย "#" (comment ของ git) ถูกตัดออกก่อนตรวจ

message_file="$1"

# ไม่มีไฟล์ข้อความ (บางกรณีเช่น rebase/am) → ปล่อยผ่าน
if [ -z "$message_file" ] || [ ! -f "$message_file" ]; then
    exit 0
fi

# บรรทัด footer ที่ต้องปฏิเสธ (เทียบทั้งบรรทัด, ไม่สนตัวพิมพ์เล็ก/ใหญ่)
#   1) "🤖 Generated with Codebuff"
#   2) "Co-Authored-By: Codebuff <noreply@codebuff.com>"
#   3) ที่อยู่อีเมลของ Codebuff ที่อยู่บรรทัดเดี่ยว ๆ
#
# !! ห้ามเขียนข้อ 1 เป็น '^[^[:alnum:]]*generated with codebuff$' !!
# แบบนั้นต้องให้ character class "กิน" ไบต์ของ emoji ซึ่งผลขึ้นกับ locale:
# ทดสอบแล้วว่าในสภาพแวดล้อมที่ git เรียกฮุก grep หาไม่เจอ (commit ที่มี 🤖 หลุด)
# ทั้งที่รันมือจากเชลล์หาเจอ จึงจับ "ตัวคั่นก่อนคำ" แทน ซึ่งเป็นช่องว่าง ASCII เสมอ
footer_patterns='(^|[^[:alnum:]])generated with codebuff[[:space:]]*$'
footer_patterns="$footer_patterns"'|^[[:space:]]*co-authored-by:.*codebuff'
footer_patterns="$footer_patterns"'|^[[:space:]]*<?noreply@codebuff\.com>?[[:space:]]*$'

violations=$(
    sed -e 's/^#.*$//' "$message_file" \
        | grep -inE "$footer_patterns"
)

if [ -n "$violations" ]; then
    printf '\n'
    printf '\xe2\x9c\x96 ปฏิเสธการ commit: ข้อความยังมี footer ของ Codebuff\n\n'
    printf '%s\n' "$violations" | sed -e 's/^/    /'
    printf '\n'
    printf 'ลบบรรทัดเหล่านี้ออกจากข้อความ commit แล้ว commit ใหม่\n'
    printf 'ถ้าจำเป็นต้อง commit จริง ๆ ใช้: git commit --no-verify\n\n'
    exit 1
fi

exit 0
